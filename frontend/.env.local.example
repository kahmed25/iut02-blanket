# Local Development Environment Variables
# Copy this to .env.local for local development (optional)

# Local backend API URL (default if not set)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Note: If NEXT_PUBLIC_API_URL is not set, it defaults to http://localhost:8000
# For local development, you typically don't need to create .env.local
# The defaults in the code work fine for Phase 1 local development
