# Backend Configuration File
# Copy this file to .env and update the values as needed

# =============================================================================
# DATA SOURCE CONFIGURATION
# =============================================================================

# Excel file source type: "local" or "url"
# - "local": Read Excel file from local filesystem
# - "url": Download Excel file from a remote URL (GitHub, S3, etc.)
EXCEL_SOURCE_TYPE=local

# Excel file URL (used when EXCEL_SOURCE_TYPE=url)
# Example for GitHub raw URL:
EXCEL_URL=https://raw.githubusercontent.com/kahmed25/iut02-blanket/dev/i.02%20blanket%20distribution%202026.xlsx

# Images source type: "local" or "url"
# - "local": Serve images from local filesystem
# - "url": Proxy images from remote URLs
IMAGES_SOURCE_TYPE=local

# Images base URL (used when IMAGES_SOURCE_TYPE=url)
# Example for GitHub raw URL:
IMAGES_BASE_URL=https://raw.githubusercontent.com/kahmed25/iut02-blanket/dev/images

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Cache expiration time in seconds (default: 300 = 5 minutes)
# Cached Excel files and images will be refreshed after this duration
CACHE_EXPIRATION_SECONDS=300

# =============================================================================
# API SERVER CONFIGURATION
# =============================================================================

# API host (default: localhost)
API_HOST=localhost

# API port (default: 8000)
API_PORT=8000

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================

# --- Example 1: Local Development (Default) ---
# EXCEL_SOURCE_TYPE=local
# IMAGES_SOURCE_TYPE=local
# (Local files will be used from project directory)

# --- Example 2: Remote Data from GitHub ---
# EXCEL_SOURCE_TYPE=url
# EXCEL_URL=https://raw.githubusercontent.com/kahmed25/iut02-blanket/dev/i.02%20blanket%20distribution%202026.xlsx
# IMAGES_SOURCE_TYPE=url
# IMAGES_BASE_URL=https://raw.githubusercontent.com/kahmed25/iut02-blanket/dev/images

# --- Example 3: Mixed (Local Excel, Remote Images) ---
# EXCEL_SOURCE_TYPE=local
# IMAGES_SOURCE_TYPE=url
# IMAGES_BASE_URL=https://raw.githubusercontent.com/kahmed25/iut02-blanket/dev/images

# --- Example 4: AWS S3 URLs ---
# EXCEL_SOURCE_TYPE=url
# EXCEL_URL=https://your-bucket.s3.amazonaws.com/data/blanket-distribution.xlsx
# IMAGES_SOURCE_TYPE=url
# IMAGES_BASE_URL=https://your-bucket.s3.amazonaws.com/images

# =============================================================================
# AUTHENTICATION CONFIGURATION (Phase 4)
# =============================================================================

# Environment (local or aws)
ENVIRONMENT=local

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/auth/callback/facebook

# Amazon OAuth
AMAZON_CLIENT_ID=your-amazon-client-id
AMAZON_CLIENT_SECRET=your-amazon-client-secret
AMAZON_REDIRECT_URI=http://localhost:3000/auth/callback/amazon

# Frontend URL
FRONTEND_URL=http://localhost:3000

# DynamoDB Configuration (for AWS environment)
DYNAMODB_REGION=us-east-1
DYNAMODB_USERS_TABLE=iut02-users
DYNAMODB_SESSIONS_TABLE=iut02-sessions

# Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# AWS SES EMAIL CONFIGURATION
# =============================================================================

# Enable/disable email sending (true/false)
EMAIL_ENABLED=true

# AWS Region for SES (use us-east-1 where devopz.ai domain is verified)
AWS_REGION=us-east-1

# SES From Email (domain devopz.ai is verified, no individual verification needed)
SES_FROM_EMAIL=login@devopz.ai

# SES From Name (display name)
SES_FROM_NAME=IUT02 Care
